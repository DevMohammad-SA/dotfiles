{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 34,
  "margin-top": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [],
  "modules-right": [
    "custom/kblayout",
    "cpu",
    "memory",
    "custom/gpu",
    "pulseaudio",
    "network",
    "custom/sep1",
    "battery",
    "custom/sep2",
    "clock",
    "custom/sep3",
    "tray"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "focused": "●",
      "default": "○"
    }
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10,
    "tooltip": false
  },
  "custom/kblayout": {
    "exec": "$HOME/.config/waybar/scripts/kblayout.sh",
    "interval": 1,
    "tooltip": false
  },
  "cpu": {
    "interval": 5,
    "format": " {usage}%",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "tooltip": false
  },
  "memory": {
    "interval": 5,
    "format": " {percentage}%",
    "states": {
      "warning": 80,
      "critical": 90
    },
    "tooltip": false
  },
  "custom/gpu": {
    "exec": "$HOME/.config/waybar/scripts/gpu.sh",
    "format": "󰢮 {}",
    "interval": 5,
    "return-type": "json",
    "tooltip": false
  },
  "custom/sep1": {
    "format": "│",
    "tooltip": false
  },
  "custom/sep2": {
    "format": "│",
    "tooltip": false
  },
  "custom/sep3": {
    "format": "│",
    "tooltip": false
  },
  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "tooltip": false
  },
  "network": {
    "format-wifi": "󰖩 {signalStrength}%",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰖪 offline",
    "tooltip-format": "{essid} · {ipaddr}",
    "tooltip": true
  },
  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "format-bluetooth": " {volume}%",
    "on-click": "pavucontrol",
    "tooltip": false
  },
  "clock": {
    "format": "󰅐 {:%a %d %b, %I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
