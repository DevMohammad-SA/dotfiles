width=600
height=460
orientation=vertical
halign=fill
allow_images=true
image_size=32
allow_markup=true
insensitive=true
matching=fuzzy
sort_order=alphabetical
prompt=Search...
filter_rate=100
hide_scroll=true
dynamic_lines=true
gtk_dark=true
# Open above fullscreen windows (games, videos) and close when clicking away
layer=overlay
close_on_focus_loss=true
# Terminal for Terminal=true desktop entries (btop, nvim, ...)
term=alacritty
# Vim-style navigation alongside the arrow keys; Ctrl-l expands app actions
# (e.g. "New Private Window"), Ctrl-u/d page through long lists
key_down=Down,Ctrl-j
key_up=Up,Ctrl-k
key_expand=Ctrl-l
key_pgdn=Page_Down,Ctrl-d
key_pgup=Page_Up,Ctrl-u
line_wrap=off
